{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sproutboat.com/schema/worker-metadata.schema.json",
  "title": "WorkerMetadata",
  "description": "Cloudflare script-upload metadata as the Sproutboat bundle build accepts it. Field names are Cloudflare's; triggers and queue_consumers are Sproutboat extensions.",
  "type": "object",
  "required": ["main_module", "compatibility_date"],
  "additionalProperties": false,
  "properties": {
    "main_module": { "type": "string", "minLength": 1, "maxLength": 256 },
    "compatibility_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "compatibility_flags": {
      "type": "array",
      "items": {
        "enum": [
          "nodejs_compat",
          "nodejs_compat_v2",
          "nodejs_als",
          "nodejs_compat_populate_process_env",
          "global_fetch_strictly_public"
        ]
      }
    },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "keep_bindings": { "type": "array", "items": { "enum": ["secret_text", "secret_key"] } },
    "keep_assets": { "type": "boolean" },
    "migrations": { "$ref": "#/$defs/migrations" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "config": { "$ref": "#/$defs/assetsConfig" } }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "crons": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 128 } } }
    },
    "queue_consumers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/queueConsumer" } },
    "observability": {},
    "logpush": {},
    "tail_consumers": {},
    "placement": {},
    "usage_model": {},
    "tags": {},
    "annotations": {},
    "limits": {}
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^(?!__proto__$)[A-Za-z_][A-Za-z0-9_]*$" },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "name", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "plain_text" },
            "name": { "$ref": "#/$defs/name" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "json"],
          "additionalProperties": false,
          "properties": { "type": { "const": "json" }, "name": { "$ref": "#/$defs/name" }, "json": {} }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "secret_text" },
            "name": { "$ref": "#/$defs/name" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "kv_namespace" },
            "name": { "$ref": "#/$defs/name" },
            "namespace_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": { "type": { "const": "d1" }, "name": { "$ref": "#/$defs/name" }, "id": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "r2_bucket" },
            "name": { "$ref": "#/$defs/name" },
            "bucket_name": { "type": "string" },
            "jurisdiction": { "const": "default" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "queue_name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "queue" },
            "name": { "$ref": "#/$defs/name" },
            "queue_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "class_name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "durable_object_namespace" },
            "name": { "$ref": "#/$defs/name" },
            "class_name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "service"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "service" },
            "name": { "$ref": "#/$defs/name" },
            "service": { "type": "string", "minLength": 1 },
            "entrypoint": { "const": "default" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "analytics_engine" },
            "name": { "$ref": "#/$defs/name" },
            "dataset": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "name", "simple"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "ratelimit" },
            "name": { "$ref": "#/$defs/name" },
            "namespace_id": { "type": "string" },
            "simple": {
              "type": "object",
              "required": ["limit", "period"],
              "additionalProperties": false,
              "properties": {
                "limit": { "type": "integer", "minimum": 1 },
                "period": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": { "type": { "const": "assets" }, "name": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": { "type": { "const": "version_metadata" }, "name": { "$ref": "#/$defs/name" } }
        }
      ]
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new_classes": { "type": "array", "items": { "type": "string" } },
        "new_sqlite_classes": { "type": "array", "items": { "type": "string" } },
        "renamed_classes": { "type": "array", "maxItems": 0 },
        "deleted_classes": { "type": "array", "maxItems": 0 },
        "transferred_classes": { "type": "array", "maxItems": 0 }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "old_tag": { "type": "string", "maxLength": 128 },
        "new_tag": { "type": "string", "maxLength": 128 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/migrationStep" } },
        "new_classes": { "type": "array", "items": { "type": "string" } },
        "new_sqlite_classes": { "type": "array", "items": { "type": "string" } },
        "renamed_classes": { "type": "array", "maxItems": 0 },
        "deleted_classes": { "type": "array", "maxItems": 0 },
        "transferred_classes": { "type": "array", "maxItems": 0 }
      }
    },
    "assetsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_found_handling": { "enum": ["none", "single-page-application", "404-page"] },
        "run_worker_first": { "oneOf": [{ "type": "boolean" }, { "type": "array", "items": { "type": "string" } }] },
        "html_handling": { "const": "auto-trailing-slash" },
        "_headers": { "type": "string" },
        "_redirects": { "type": "string" }
      }
    },
    "queueConsumer": {
      "type": "object",
      "required": ["queue"],
      "additionalProperties": false,
      "properties": {
        "queue": { "type": "string", "minLength": 1 },
        "max_batch_size": { "type": "number", "minimum": 0, "maximum": 100 },
        "max_batch_timeout": { "type": "number", "minimum": 0, "maximum": 60 },
        "max_retries": { "type": "number", "minimum": 0, "maximum": 100 },
        "retry_delay": { "type": "number", "minimum": 0, "maximum": 86400 },
        "dead_letter_queue": { "type": "string", "minLength": 1 }
      }
    },
    "module": {
      "type": "object",
      "required": ["name", "type", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "enum": ["esm", "cjs", "text", "data", "sourcemap"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["main_module", "modules", "metadata"],
      "additionalProperties": false,
      "properties": {
        "main_module": { "type": "string" },
        "modules": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/module" } },
        "metadata": { "$ref": "#" }
      }
    }
  }
}
