{
  "name": "kitchen-sink",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "$schema": "https://sproutboat.com/schema.json",
  "vars": {
    "SITE_NAME": "Sproutboat Notes",
    "MAX_UPLOAD_BYTES": "26214400",
    "MAX_TOTAL_BYTES": "209715200",
    "MAX_RESPONSE_BYTES": "2097152",
    "MAX_UPLOAD_PER_HOUR": "104857600",
    "MAX_UPLOAD_PER_DAY": "104857600",
    "FILE_TTL_SECONDS": "3600",
    "MAX_DOWNLOAD_PER_HOUR": "262144000"
  },
  "kv_namespaces": [
    "SESSIONS"
  ],
  "secrets": [
    "ADMIN_TOKEN"
  ],
  "d1_databases": [
    "DB"
  ],
  "r2_buckets": [
    "UPLOADS"
  ],
  "queues": [
    "EMAILS"
  ],
  "analytics_engine_datasets": [
    "METRICS"
  ],
  "durable_objects": {
    "ROOM": "ChatRoom"
  },
  "services": [
    {
      "binding": "PEER",
      "service": "quote-service"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *",
      "*/15 * * * *",
      "0 4 * * *"
    ]
  },
  "ratelimiters": [
    {
      "binding": "THROTTLE",
      "limit": 3,
      "period": 60
    },
    {
      "binding": "WRITES",
      "limit": 30,
      "period": 60
    },
    {
      "binding": "BULK",
      "limit": 60,
      "period": 60
    },
    {
      "binding": "READS",
      "limit": 240,
      "period": 60
    }
  ],
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_sprout_first": true
  }
}
