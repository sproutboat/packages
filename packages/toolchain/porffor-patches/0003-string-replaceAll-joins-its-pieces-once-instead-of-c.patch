From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] string: replaceAll joins its pieces once instead of copying
 the output per match

String.prototype.replaceAll is quadratic: each match concatenates the whole output again.
Over 148,890 characters it takes 147 ms, over 628,890 characters 2,009 ms (4x input, 13.7x time).
The pieces are collected and joined once.

Class: upstream
Pass: patchReplaceAll
Upstream: https://github.com/CanadaHonk/porffor/issues/459
---
 compiler/builtins/string.ts | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/compiler/builtins/string.ts b/compiler/builtins/string.ts
index 09e4c32d998c4f6584f4581a7473df1698bd8d67..f059b39f336d4bc3397ae437f4aafaab7acd2b57 100644
--- a/compiler/builtins/string.ts
+++ b/compiler/builtins/string.ts
@@ -1183,7 +1183,8 @@ export const __Porffor_string_replaceAll = (str: any, searchValue: any, replaceV
   match[0] = searchValue;
   match.input = str;
 
-  let out: any = __Porffor_string_emptyLike(str);
+  // sproutboat #237: pieces joined once, not a strcat (full copy) per match.
+  const pieces: any[] = Porffor.array.new(0);
   let appendIndex: i32 = 0;
   let searchIndex: i32 = 0;
   let matched: boolean = false;
@@ -1194,8 +1195,8 @@ export const __Porffor_string_replaceAll = (str: any, searchValue: any, replaceV
 
     matched = true;
     match.index = matchIndex;
-    out = __Porffor_strcat(out, __Porffor_string_substringLike(str, appendIndex, matchIndex));
-    out = __Porffor_strcat(out, __Porffor_string_applyReplacer(str, match, matchIndex, replaceValue));
+    Porffor.array.fastPush(pieces, __Porffor_string_substringLike(str, appendIndex, matchIndex));
+    Porffor.array.fastPush(pieces, __Porffor_string_applyReplacer(str, match, matchIndex, replaceValue));
 
     appendIndex = matchIndex + searchLen;
     if (searchLen == 0) {
@@ -1208,7 +1209,8 @@ export const __Porffor_string_replaceAll = (str: any, searchValue: any, replaceV
   }
 
   if (!matched) return str;
-  return __Porffor_strcat(out, __Porffor_string_substringLike(str, appendIndex, thisLen));
+  Porffor.array.fastPush(pieces, __Porffor_string_substringLike(str, appendIndex, thisLen));
+  return Porffor.callThis(__Array_prototype_join, pieces, '');
 };
 
 export const __String_prototype_replaceAll = function (this: any, searchValue: any, replaceValue: any) {
