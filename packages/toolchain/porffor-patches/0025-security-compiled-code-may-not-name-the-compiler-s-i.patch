index 0787f7e12caaebbbb0b8c83254b987635134d5ee..a849c5fae6f945ace2d09ef719c677bdadabfced 100644
--- a/compiler/codegen.js
+++ b/compiler/codegen.js
@@ -12,6 +12,7 @@ import { BuiltinFuncs, BuiltinVars, fullPrototypes } from './builtins.js';
 import { TYPES, TYPE_FLAGS, TYPE_NAMES, TYPED_ARRAY_TYPES, ITERATOR_TYPES } from './types.js';
 import semantic, { knownValue, unknownValue, storageInt } from './semantic.js';
 import parse from './parse.js';
+import { refuseIntrinsics } from './refuse.js';
 import { patternNames, appModuleIds } from './modules.js';
 import temporalPolyfillSource from './intl/temporal.js';
 import intlPolyfillSource from './intl/intl.js';
@@ -2272,7 +2273,7 @@ const generateCall = (scope, decl) => {
       const fnArgs = knowns.slice(0, -1).map(x => String(x));
       let parsed;
       try {
-        parsed = semantic(objectHack(parse(`(function(${fnArgs.join(',')}){${code}})`)), decl._semanticScopes);
+        parsed = semantic(objectHack(refuseIntrinsics(parse(`(function(${fnArgs.join(',')}){${code}})`), 'code given to Function')), decl._semanticScopes);
       } catch (e) {
         if (e.name === 'SyntaxError') return internalThrow(scope, 'SyntaxError', e.message);
         throw e;
