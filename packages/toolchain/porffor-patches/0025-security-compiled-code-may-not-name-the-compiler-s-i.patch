+    refuseIntrinsics(body, 'code given to vm');
   } catch (e) {
     if (e.name !== 'SyntaxError') throw e;
     return { type: 'NewExpression', callee: ident('SyntaxError'), arguments: [ literal(e.message) ] };
@@ -787,6 +800,7 @@ const vmModule = (code, id) => {
   let body;
   try {
