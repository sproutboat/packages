From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] codegen: class methods and constructors stay in their
 module's unit (P1)

Methods and constructors of a module's classes landed in `main` instead of the module's unit, so an
app's classes changed the shared prefix of the template.

Class: ours
Pass: patchClassUnit (P1)
---
 compiler/codegen.js | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/compiler/codegen.js b/compiler/codegen.js
index 16f765a0b8913084e6eb868f53ed78160c63a778..b1dfcd97f6e947cd55ebdbc768d5403db02ade76 100644
--- a/compiler/codegen.js
+++ b/compiler/codegen.js
@@ -5438,7 +5438,11 @@ const classSuperExpr = () => ({
   ]
 });
 
+let classUnit = null; // sproutboat P1: class functions stay in their module's unit instead of #main
 const declareClass = (scope, decl) => {
+  const prev = classUnit; if (decl._unit != null) classUnit = decl._unit; try { return declareClass0(scope, decl); } finally { classUnit = prev; }
+};
+const declareClass0 = (scope, decl) => {
   const expr = decl.type === 'ClassExpression';
   const name = decl.id.name;
   const body = decl.body.body;
@@ -5495,6 +5499,9 @@ const declareClass = (scope, decl) => {
 };
 
 const generateClass = (scope, decl) => {
+  const prevClassUnit = classUnit; if (decl._unit != null) classUnit = decl._unit; try { return generateClass0(scope, decl); } finally { classUnit = prevClassUnit; }
+};
+const generateClass0 = (scope, decl) => {
   const expr = decl.type === 'ClassExpression';
   if (!expr && !classHasDefinitionSideEffects(decl) && (decl._refs ?? 0) === 0) {
     return valUndefined();
@@ -6239,7 +6246,7 @@ const generateFunc = (scope, decl, forceNoExpr = false) => {
     strict: decl.strict ?? scope.strict,
     usesArguments: decl._usesArguments,
     ast: decl,
-    unit: decl._unit ?? decl._hoistedUnit ?? scope.unit,
+    unit: decl._unit ?? decl._hoistedUnit ?? scope.unit ?? classUnit,
     parentFunc: scope.name ? scope : null,
     selfAware: !!decl._selfAware,
     directCallOnly,
